NODE_ENV=production
APP_URL=https://TU-SITIO.netlify.app
DB_HOST=TU-SERVIDOR-MYSQL
DB_PORT=3306
DB_NAME=los_magueyes
DB_USER=TU-USUARIO
DB_PASSWORD=
DB_SSL=true
# Solo si el proveedor requiere un certificado CA propio. Usa \n entre líneas.
DB_SSL_CA=
DB_CONNECTION_LIMIT=2
SESSION_SECRET=
TRUST_PROXY_HOPS=1
# Solo para setup:production en tu computadora; no requeridas en Netlify.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@losmagueyes.com
ADMIN_PASSWORD=
