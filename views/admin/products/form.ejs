<%- include('../../partials/header', { title }) %>
<div class="admin-shell">
  <%- include('../../partials/adminNav') %>
  <section class="admin-content narrow">
    <div class="admin-heading"><div><p class="eyebrow">Catálogo</p><h1><%= title %></h1></div><a href="/admin/productos">Regresar</a></div>
    <form class="admin-card form-grid" action="<%= action %>" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (errors.length) { %><div class="errors full"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %>
      <label>Categoría<select name="category_id" required><option value="">Selecciona</option><% categories.forEach(category => { %><option value="<%= category.id %>" <%= Number(product.category_id) === category.id ? 'selected' : '' %>><%= category.name %></option><% }) %></select></label>
      <label>Nombre<input name="name" value="<%= product.name || '' %>" required maxlength="120"></label>
      <label class="full">Descripción<textarea name="description" rows="4" maxlength="500"><%= product.description || '' %></textarea></label>
      <label>Precio<input type="number" name="price" value="<%= product.price ?? '' %>" min="0" max="99999" step="0.01" required></label>
      <label class="checkbox"><input type="checkbox" name="available" value="1" <%= product.available === undefined || product.available ? 'checked' : '' %>> Producto disponible</label>
      <div class="full"><button class="button button-primary" type="submit">Guardar producto</button></div>
    </form>
  </section>
</div>
<%- include('../../partials/footer') %>
