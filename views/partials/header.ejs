<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Los Magueyes, barbacoa estilo Hidalgo desde 2002.">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> | Los Magueyes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Rye&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Los Magueyes, inicio">
      <span class="brand-mark">M</span>
      <span><strong>Los Magueyes</strong><small>Barbacoa estilo Hidalgo</small></span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Abrir menú" aria-expanded="false">☰</button>
    <nav class="main-nav" aria-label="Navegación principal">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Inicio</a>
      <a class="<%= currentPath === '/menu' ? 'active' : '' %>" href="/menu">Menú y pedidos</a>
      <a class="<%= currentPath === '/nosotros' ? 'active' : '' %>" href="/nosotros">Nosotros</a>
      <% if (user) { %>
        <a href="/admin">Administración</a>
        <form action="/auth/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit">Salir</button></form>
      <% } else { %>
        <a href="/auth/login">Acceso</a>
      <% } %>
    </nav>
  </header>
  <% if (flash) { %><div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
